# Copie este arquivo para ".env" e preencha com a connection string do seu banco Postgres (Neon).
# No Vercel, essa variável é preenchida automaticamente quando você conecta a integração Neon
# na aba Storage do seu projeto — para rodar local, copie o valor de lá.
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/quiz?sslmode=require
